# Supabase (Project Settings > API) - utilisées côté serveur uniquement
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # clé SECRÈTE (sb_secret_...), pas la clé publique

# Mot de passe d'accès à l'application (obligatoire en production)
APP_PASSWORD=

# IA : laisser AI_API_KEY vide = pré-notes simulées (aucun appel externe).
# Avec une clé Google Gemini, l'application interroge le vrai modèle ;
# en cas d'erreur, elle retombe automatiquement sur la simulation.
AI_API_KEY=
# Optionnel : nom du modèle (par défaut : gemini-2.5-flash)
AI_MODEL=